<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VirtualKM</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HIDMaestro.Core"><HintPath>lib/HIDMaestro.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Windows.SDK.NET"><HintPath>lib/Microsoft.Windows.SDK.NET.dll</HintPath></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>lib/WinRT.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
